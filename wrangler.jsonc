{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestor-publicaciones",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "TIME_ZONE": "Europe/Madrid",
    "MAX_ATTEMPTS": "3"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestor-publicaciones-db",
      "migrations_dir": "migrations"
    }
  ]
}